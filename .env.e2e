# Build usado pelos testes E2E (npm run build:e2e).
# Timeout curto para o cenário de timeout após criar o pedido não atrasar a suíte.
VITE_API_TIMEOUT_MS=3000

# React de desenvolvimento no build dos testes: avisos como campo controlado/não
# controlado aparecem no console e o fixture faz o teste falhar.
NODE_ENV=development
