# URL base da API REST. Com os mocks ativos, o MSW intercepta este caminho.
VITE_API_BASE_URL=/api

# Backend simulado (MSW). Ativo por padrão, inclusive no build de demonstração.
# Use "false" para desligar.
VITE_ENABLE_MOCKS=true

# Origem do servidor Socket.IO. Padrão: a própria origem da página.
# VITE_SOCKET_URL=http://localhost:5173
